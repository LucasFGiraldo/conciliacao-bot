# Copie este arquivo para .env e preencha com os seus valores.
# O .env NÃO é versionado.

# ── API Anthropic ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# ── Caminhos ──
PASTA_COMP=dados/comprovantes
PASTA_EXTRATOS=dados/extratos
PLANILHA=dados/fluxo_de_caixa.xlsx
PASTA_SAIDA=dados/saida

# ── Conta bancária ──
BANCO=Bradesco
CONTA=00000-0

# ── Regras específicas ──
# Nome da empresa no cabeçalho das páginas do extrato PDF (linha ignorada)
EMPRESA_CABECALHO_PDF=MINHA EMPRESA
# Fornecedor que paga 1 PIX no extrato correspondente a N linhas na planilha
FORNECEDOR_AGRUPADO=FORNECEDOR X
# Fornecedores PJ conhecidos, separados por vírgula
FORNECEDORES_PJ=FORNECEDOR A,FORNECEDOR B
